# ABot 配置 —— 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）。
# 所有配置只经环境变量读取，没有文件型配置。

# sea-orm 连接串。必须是 Postgres（不支持 SQLite）。
DATABASE_URL=postgres://abot:abot@127.0.0.1:5432/abot

# OneBot v11 正向 WS 端点（Lagrange 跑 WS 服务端，abot 作为客户端拨入）。
ONEBOT_WS_URL=ws://127.0.0.1:41573/onebot/v11/ws

# 主人（owner）QQ 号；启动就绪后给他私聊发上线通知，且总是并入超管。留空/0 即无主人。
MASTER=

# 超级用户 QQ 号清单（逗号分隔）；喂给 superuser() 规则。留空即无超管。
SUPERUSERS=

# 网页控制台监听地址（默认仅绑本地；对外暴露请自行反代加 TLS）。
WEB_BIND=127.0.0.1:8080

# 图片归档根目录（媒体服务按内容 md5 分片落盘）。
IMAGE_DIR=./data/images

# 腾讯云内容审核（TMS 文本 / IMS 图片）。留空则审核不可用，需审核的内容会被拒。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
TENCENT_TEXT_BIZTYPE=
TENCENT_IMAGE_BIZTYPE=

# 日志来源过滤（tracing EnvFilter 语法）。按 target 过滤，如 nagisa::onebot=warn。
RUST_LOG=info,sqlx=warn
